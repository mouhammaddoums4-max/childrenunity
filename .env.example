##
# Variables d'environnement du site.
#
# Copiez ce fichier en `.env.local` pour le développement, et reportez les
# mêmes clés dans les variables du service d'hébergement (Railway) pour la
# production. `.env*` est ignoré par git : aucun secret ne part dans le dépôt.
#
# Ce fichier-ci ne contient QUE des exemples. N'y écrivez jamais une vraie
# clé : c'est le seul `.env` qui soit versionné.
##

# ---------------------------------------------------------------------
# Domaine public
# ---------------------------------------------------------------------
# Sert aux URL du sitemap, aux liens canoniques, aux vignettes de partage
# et aux liens d'approbation d'adhésion. Sans cette variable, le site
# retombe sur https://childrensunityfoundation.org, ce qui produit des
# liens faux si le domaine réel est différent.
NEXT_PUBLIC_SITE_URL=https://childrensunityfoundation.org

# ---------------------------------------------------------------------
# Statut de publication
# ---------------------------------------------------------------------
# Tant que cette variable ne vaut pas `live`, le site interdit son
# indexation. Voir src/lib/publication.ts : il faut AUSSI y passer
# `contentReviewed` à true, une fois les vrais contenus saisis, sinon les
# sections non vérifiées resteront masquées.
NEXT_PUBLIC_SITE_STATUS=draft

# ---------------------------------------------------------------------
# Adhésions — signature des liens d'approbation
# ---------------------------------------------------------------------
# 32 caractères minimum. Le dossier d'adhésion voyage signé dans le lien
# d'approbation envoyé à l'administration : sans cette clé, aucun lien
# n'est généré et l'approbation ne peut pas se faire depuis le courriel.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEMBERSHIP_SECRET=

# ---------------------------------------------------------------------
# Courriel — Resend
# ---------------------------------------------------------------------
# Sans ces clés, AUCUN courriel n'est envoyé et l'interface le dit au
# visiteur au lieu de prétendre le contraire.
RESEND_API_KEY=
MAIL_FROM=Children's Unity Foundation <contact@childrensunityfoundation.org>
# Destinataire des demandes d'adhésion. À défaut, l'adresse publique de
# la fondation est utilisée.
MEMBERSHIP_NOTIFY_EMAIL=contact@childrensunityfoundation.org

# ---------------------------------------------------------------------
# SMS — Nimba SMS
# ---------------------------------------------------------------------
# Authentification HTTP Basic : identifiant de service et jeton secret.
# `SMS_SENDER_ID` doit être un nom d'expéditeur validé sur le compte,
# sinon la passerelle refuse l'envoi.
SMS_PROVIDER=nimbasms
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# ---------------------------------------------------------------------
# Images — Cloudinary (facultatif)
# ---------------------------------------------------------------------
CLOUDINARY_URL=

# ---------------------------------------------------------------------
# Infolettre (facultatif)
# ---------------------------------------------------------------------
# URL du formulaire du prestataire (Brevo, Mailchimp, Buttondown...).
# Sans elle, l'inscription passe par le logiciel de messagerie du visiteur.
# L'origine de cette URL est automatiquement ajoutée à `connect-src` dans
# la politique de sécurité : ne l'ouvrez pas à la main.
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=https://exemple.brevo.com/xxxx
